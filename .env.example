# Load explicitly: python run.py --env-file .env --mode linq
SAFESIGHT_MODE=preview
CAMERA_SOURCE=0
CAMERA_FPS=30
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
CAMERA_MIRROR=1

# Optional operator access control; configure BOTH values. Use TLS for remote use.
# SAFESIGHT_AUTH_USER=
# SAFESIGHT_AUTH_PASSWORD=

# Cloud settings from the organizer notebook. Do not commit real credentials.
RABBITMQ_HOST=10.0.114.30
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
LINQ_LOGIN=
# Or override the complete worker-side program URI:
# LINQ_PROGRAM_URI=file:///auto/cache/YOUR_LOGIN/yolov8n.tpu?raw=False
LINQ_INPUT_NAME=images
LINQ_OUTPUT_NAME=output0
LINQ_MAX_INFLIGHT=1
LINQ_MAX_REQUEST_FPS=2
LINQ_TIMEOUT=10
LINQ_MAX_RESULT_AGE=3

# JPEG Gateway transport (set route printed by remote GATEWAY READY).
# When LINQ_JPEG_ROUTE is nonempty and mode=linq, tensors stay in the LinQ cloud.
# LINQ_JPEG_ROUTE=safesight.jpeg.REPLACE_WITH_CURRENT_GATEWAY_ROUTE
# LINQ_JPEG_QUALITY=75

# Optional independent SafetyVision gateway (unique route from its READY log).
# LINQ_SV_ROUTE=safesight.jpeg.sv.REPLACE_WITH_CURRENT_GATEWAY_ROUTE
# LINQ_SV_MAX_REQUEST_FPS=1.5
# LINQ_SV_JPEG_QUALITY=75
# Join deadline is bounded by LINQ_MAX_RESULT_AGE; tune from measured SV RTT.
# LINQ_SV_JOIN_GRACE=0.70
# SV requires 3 hits in the last 4 actual SV observations, with a bounded gap.
# SAFESIGHT_SV_CONFIRM_WINDOW=4
# SAFESIGHT_SV_MAX_GAP=2.5
# Thresholds are provisional; tune on a separate labelled validation split.
# SAFESIGHT_SV_THRESHOLDS={"no_helmet":0.45,"fall_detected":0.45,"hardhat":0.40}
