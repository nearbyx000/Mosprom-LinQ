# Load explicitly: python run.py --env-file .env --mode linq
SAFESIGHT_MODE=preview
CAMERA_SOURCE=0
CAMERA_FPS=30
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
CAMERA_MIRROR=1

# Cloud settings from the organizer notebook. Do not commit real credentials.
RABBITMQ_HOST=10.0.114.30
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
LINQ_LOGIN=
# Or override the complete worker-side program URI:
# LINQ_PROGRAM_URI=file:///auto/cache/YOUR_LOGIN/yolov8n.tpu?raw=False
LINQ_INPUT_NAME=images
LINQ_OUTPUT_NAME=output0
LINQ_MAX_INFLIGHT=1
LINQ_MAX_REQUEST_FPS=2
LINQ_TIMEOUT=10
LINQ_MAX_RESULT_AGE=3
